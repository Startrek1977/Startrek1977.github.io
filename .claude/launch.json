{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio-site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-c",
        "import http.server,os;PORT=int(os.environ.get('PORT','8000'));Handler=http.server.SimpleHTTPRequestHandler;http.server.ThreadingHTTPServer.allow_reuse_address=True;httpd=http.server.ThreadingHTTPServer(('',PORT),Handler);print('serving on',PORT);httpd.serve_forever()"
      ],
      "port": 8000,
      "autoPort": false
    }
  ]
}
